/*******************************************************************************
*         McXtrace instrument definition URL=http://www.mcxtrace.org
*
* Instrument: exB2_mcxtrace_starter
*
* %Identification
* Written by: PaNRAID School
* Date: 2026
* Origin: PaNRAID / Optics exercises
* %INSTRUMENT_SITE: Templates
*
* Starter instrument for Exercises B1-B2 ("A synchrotron monochromator",
* Track 1) of the Optics hands-on exercises: a synchrotron-like source,
* monitors at the aperture, and a single Si(111) Bragg_crystal on a
* rotated arm - the geometry from B2 steps 3-6.
*
* Deliberately NOT done for you: the crystal angle. `A1` defaults to 0,
* i.e. no reflection condition is met and the downstream monitors will
* show nothing coming through. Work out theta from Bragg's law for a
* photon energy in range (see the exercise sheet, step 7) and set A1
* yourself - that calculation, and the rocking-curve scan around it
* (step 8), are the actual exercise. Extending this into a double-crystal
* monochromator (steps 9-11) is left to you too.
*
* %Parameters
* E0: [keV]   Mean source photon energy
* dE: [keV]   Source energy half-width
* A1: [deg]   Crystal 1 rotation angle (Bragg angle theta) - 0 by default
*
* %End
*******************************************************************************/
DEFINE INSTRUMENT exB2_mcxtrace_starter(E0=8, dE=0.5, A1=0)

TRACE

COMPONENT origin = Progress_bar()
AT (0,0,0) ABSOLUTE

/* Exercise B1: synchrotron-like source, focused onto a small aperture
 * 30 m downstream - check mxdoc Source_gaussian for beam-size parameters
 * (sigmax/sigmay or similar) if you want a more realistic footprint. */
COMPONENT src = Source_gaussian(E0=E0, dE=dE, focus_xw=0.001, focus_yh=0.001, dist=30)
AT (0,0,0) RELATIVE origin

COMPONENT aperture_mon_E = E_monitor(xwidth=0.002, yheight=0.002, filename="e0.dat",
                                      Emin=E0-2*dE, Emax=E0+2*dE)
AT (0,0,30) RELATIVE src

COMPONENT aperture_mon_psd = PSD_monitor(xwidth=0.002, yheight=0.002, filename="psd0.dat")
AT (0,0,0.001) RELATIVE PREVIOUS

/* Exercise B2, step 3: A1 is exposed as an instrument parameter -
 * compute it yourself from Bragg's law (step 7) rather than reading it
 * off here. */
COMPONENT xtal1_arm = Arm()
AT (0,0,1) RELATIVE PREVIOUS
ROTATED (A1,0,0) RELATIVE PREVIOUS

/* Exercise B2, step 4: Si(111), V=160.1826 Angs^3 is silicon's unit-cell
 * volume, h,k,l=1,1,1 selects the (111) reflection. */
COMPONENT xtal1 = Bragg_crystal(length=0.05, width=0.02, V=160.1826, h=1, k=1, l=1, alpha=0)
AT (0,0,0) RELATIVE xtal1_arm

/* Exercise B2, step 5: carries the reflected beam's new direction forward. */
COMPONENT xtal1_out = Arm()
AT (0,0,0) RELATIVE xtal1_arm
ROTATED (2*A1,0,0) RELATIVE xtal1_arm

/* Exercise B2, step 6: monitors after the (single) crystal. */
COMPONENT mono_mon_E = E_monitor(xwidth=0.01, yheight=0.01, filename="e1.dat",
                                  Emin=E0-2*dE, Emax=E0+2*dE)
AT (0,0,1) RELATIVE xtal1_out

COMPONENT mono_mon_psd = PSD_monitor(xwidth=0.01, yheight=0.01, filename="psd1.dat")
AT (0,0,0.001) RELATIVE PREVIOUS

END
